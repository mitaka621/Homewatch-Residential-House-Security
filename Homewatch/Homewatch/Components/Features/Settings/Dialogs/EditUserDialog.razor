@using Homewatch.Contracts.Constants
@using Homewatch.Contracts.Dtos.UserDtos

@inject IUserManagementService _userManagementService
@inject ISnackbar _snackbar
@inject IAdminAuthorizationGuard _adminAuthorizationGuard

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Immediate="true"
                          Disabled="_isSubmitting" />

            <MudSelect T="Guid"
                       Label="Roles"
                       Variant="Variant.Outlined"
                       SelectedValues="_selectedRoleIds"
                       SelectedValuesChanged="OnSelectedRolesChanged"
                       MultiSelection="true"
                       ToStringFunc="@GetRoleName"
                       HelperText="@(IsSelf ? "You cannot change your own roles." : null)"
                       Disabled="_isSubmitting || IsSelf">
                @foreach (var role in _availableRoles)
                {
                    <MudSelectItem T="Guid" Value="@role.Id">@role.Name</MudSelectItem>
                }
            </MudSelect>

            @if (!IsSelf)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Changing roles signs the user out.
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(_submitError))
            {
                <MudAlert Severity="Severity.Error" NoIcon="true">@_submitError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="_isSubmitting || !HasChanges || string.IsNullOrWhiteSpace(_email) || !_selectedRoleIds.Any()">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>Saving...</text>
            }
            else
            {
                <text>Save</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public Guid UserId { get; set; }

    [Parameter] public string UserName { get; set; } = string.Empty;

    [Parameter] public string InitialEmail { get; set; } = string.Empty;

    [Parameter] public List<Guid> InitialRoleIds { get; set; } = new();

    [Parameter] public Guid CurrentUserId { get; set; }

    private List<RoleDto> _availableRoles = new();
    private IEnumerable<Guid> _selectedRoleIds = Enumerable.Empty<Guid>();
    private string _email = string.Empty;
    private string _savedEmail = string.Empty;
    private string? _submitError;
    private bool _isSubmitting;

    private bool IsSelf => UserId == CurrentUserId;

    private bool IsEmailChanged => !string.Equals(_email.Trim(), _savedEmail, StringComparison.Ordinal);

    private bool AreRolesChanged => !IsSelf && !_selectedRoleIds.ToHashSet().SetEquals(InitialRoleIds);

    private bool HasChanges => IsEmailChanged || AreRolesChanged;

    protected override async Task OnInitializedAsync()
    {
        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            MudDialog?.Cancel();
            return;
        }

        _availableRoles = await _userManagementService.GetAllRolesAsync();
        _selectedRoleIds = InitialRoleIds.ToList();
        _email = InitialEmail;
        _savedEmail = InitialEmail;
    }

    private void OnSelectedRolesChanged(IEnumerable<Guid> selected)
    {
        _selectedRoleIds = selected;
    }

    private string GetRoleName(Guid id)
    {
        return _availableRoles.FirstOrDefault(r => r.Id == id)?.Name ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        _submitError = null;

        if (!_selectedRoleIds.Any())
        {
            _submitError = "Select at least one role.";
            return;
        }

        _isSubmitting = true;

        try
        {
            if (IsEmailChanged && !await UpdateEmailAsync())
            {
                return;
            }

            if (AreRolesChanged && !await UpdateRolesAsync())
            {
                return;
            }

            _snackbar.Add($"User '{UserName}' updated.", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<bool> UpdateEmailAsync()
    {
        var result = await _userManagementService.UpdateUserEmailAsync(UserId, _email);

        _submitError = result switch
        {
            UpdateUserEmailResult.InvalidEmail => $"Enter a valid email address of at most {UserConstraints.EmailMaximumLength} characters.",
            UpdateUserEmailResult.EmailInUse => "Another user already has this email address.",
            UpdateUserEmailResult.UserNotFound => "User no longer exists.",
            _ => null
        };

        if (result == UpdateUserEmailResult.Success)
        {
            _savedEmail = _email.Trim();
        }

        return result == UpdateUserEmailResult.Success;
    }

    private async Task<bool> UpdateRolesAsync()
    {
        var result = await _userManagementService.UpdateUserRolesAsync(UserId, _selectedRoleIds.ToList(), CurrentUserId);

        _submitError = result switch
        {
            UpdateUserRolesResult.CannotEditSelf => "You cannot edit your own roles.",
            UpdateUserRolesResult.UserNotFound => "User no longer exists.",
            _ => null
        };

        return result == UpdateUserRolesResult.Success;
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}
