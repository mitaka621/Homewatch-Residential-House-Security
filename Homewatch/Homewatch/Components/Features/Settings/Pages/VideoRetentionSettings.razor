@attribute [Route(AppRoutes.RetentionSettings)]
@rendermode InteractiveServer
@implements IDisposable

@using Homewatch.Contracts.Constants
@using Homewatch.Contracts.Dtos.RemoteStorageDtos
@using Homewatch.Contracts.Dtos.SystemSettingsDtos
@using Microsoft.AspNetCore.Authorization
@using System.Net

@attribute [Authorize(Roles = Roles.Admin)]

@inject ISystemSettingsService _systemSettingsService
@inject IRemoteStorageService _remoteStorageService
@inject IRemoteStorageSyncMonitor _remoteStorageSyncMonitor
@inject IRemoteStorageSyncController _remoteStorageSyncController
@inject IDeviceService _deviceService
@inject ISnackbar _snackbar
@inject IDialogService _dialogService
@inject IAdminAuthorizationGuard _adminAuthorizationGuard

<PageTitle>Video Retention - Homewatch</PageTitle>

<MudStack Spacing="4">
<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
    <MudIcon Icon="@Icons.Material.Filled.AutoDelete" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Video Retention</MudText>
</MudStack>

<MudStack Row="true">
        <MudCard Elevation="4" Style="width:800px;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Remote Storage (SMB)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Recorded camera chunks are copied to every server with video sync enabled. Local chunks are not removed by retention until they are copied. Saved changes apply right away.
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudTooltip Text="Add server connection">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       OnClick="AddTarget" />
                    </MudTooltip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudNumericField T="int"
                                     Value="_settings.ParallelCopiesPerShare"
                                     ValueChanged="OnParallelCopiesPerShareChangedAsync"
                                     Immediate="true"
                                     Label="Parallel copies per share"
                                     Min="_minimumParallelCopies"
                                     Max="_maximumParallelCopies"
                                     HelperText="Chunks copied to each share at the same time. Saved automatically. Raise it only if the upload speed of the server's network has room to spare, so the copies do not use up the whole upload." />

                    @if (_targets.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No server connections. Use + to add one.</MudText>
                    }

                    @foreach (var target in _targets)
                    {
                        <MudPaper Outlined="true" Class="pa-3" Style="position:relative">
                            <div class="video-sync-switch">
                                <MudSwitch T="bool"
                                           Value="target.IsSyncEnabled"
                                           ValueChanged="@((bool isEnabled) => OnSyncChangedAsync(target, isEnabled))"
                                           Color="Color.Success"
                                           Label="Video sync"
                                           LabelPlacement="Placement.Left"
                                           Disabled="target.IsVerifying" />
                            </div>
                            <MudStack Row Spacing="4" AlignItems="AlignItems.Center">
                                <MudStack Spacing="2" Style="flex:1;">
                                    <MudTextField T="string"
                                                  @bind-Value="target.SharePath"
                                                  Label="Share path"
                                                  Placeholder="\\192.168.0.67\cctv" />
                                    <MudTextField T="string"
                                                  @bind-Value="target.Username"
                                                  Label="Username" />
                                    <MudTextField T="string"
                                                  @bind-Value="target.Password"
                                                  Label="Password"
                                                  InputType="InputType.Password"
                                                  HelperText="@(target.HasStoredPassword ? "Leave empty to keep the current password." : null)" />
                                    <MudSelect T="RetentionPeriod"
                                               Label="Camera chunks removal"
                                               @bind-Value="target.Retention"
                                               HelperText="Footage on this server is deleted after this period, only if the video sync is enabled">
                                        @foreach (var period in Enum.GetValues<RetentionPeriod>())
                                        {
                                            <MudSelectItem Value="@period">@MiscUtilities.GetDisplayNameAttributeValue(period)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudStack>
                                <MudStack Spacing="2" Style="width:180px;">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@(_isSavingRemoteStorage ? null : Icons.Material.Filled.NetworkCheck)"
                                               OnClick="() => SaveAndVerifyTargetAsync(target)"
                                               Disabled="_isSavingRemoteStorage">
                                        @if (_isSavingRemoteStorage)
                                        {
                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                            <MudText Class="ms-2">Verifying</MudText>
                                        }
                                        else
                                        {
                                            <MudText>Save And Verify</MudText>
                                        }
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="() => RemoveTargetAsync(target)"
                                               Disabled="target.IsVerifying">
                                        <MudText>Remove</MudText>
                                    </MudButton>
                                </MudStack>
                            </MudStack>

                            @if (!string.IsNullOrEmpty(target.VerificationMessage) && target.VerificationSucceeded == false)
                            {
                                <MudAlert Class="mt-3"
                                          Dense="true"
                                          Severity="Severity.Error">
                                    @target.VerificationMessage
                                </MudAlert>
                            }

                            @if (target.Id != null && target.IsSyncEnabled && _syncStatuses.TryGetValue(target.Id.Value, out var syncStatus))
                            {
                                var syncAlert = GetSyncAlert(syncStatus);

                                <MudStack Class="mt-3" Spacing="1">
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2">Sync load</MudText>
                                        <MudText Typo="Typo.body2">@(syncStatus.State == RemoteStorageSyncState.Measuring ? "Measuring" : $"{syncStatus.LoadPercent:0}%")</MudText>
                                    </MudStack>
                                    <MudProgressLinear Value="@(syncStatus.State == RemoteStorageSyncState.Measuring ? 0 : syncStatus.LoadPercent)" Color="GetLoadColor(syncStatus)" Rounded="true" Size="Size.Medium" />
                                    @if (syncStatus.State == RemoteStorageSyncState.Measuring)
                                    {
                                        <MudText Typo="Typo.body2">Measuring the sync load during the first minute.</MudText>
                                    }
                                    else
                                    {
                                        <ul class="sync-status-list">
                                            <li>
                                                <MudText Typo="Typo.body2" Inline="true">Cameras record: </MudText>
                                                <MudText Typo="Typo.body2" Inline="true" Color="Color.Secondary">@FormatRate(syncStatus.RecordingMegabytesPerSecond)</MudText>
                                            </li>
                                            <li>
                                                <MudText Typo="Typo.body2" Inline="true">Reaches the share: </MudText>
                                                <MudText Typo="Typo.body2" Inline="true" Color="Color.Secondary">@FormatRate(syncStatus.UploadMegabytesPerSecond)</MudText>
                                            </li>
                                            <li>
                                                <MudText Typo="Typo.body2" Inline="true">Chunks waiting: </MudText>
                                                <MudText Typo="Typo.body2" Inline="true" Color="Color.Secondary">@syncStatus.PendingChunkCount</MudText>
                                            </li>
                                            <li>
                                                <MudText Typo="Typo.body2" Inline="true">Parallel copies: </MudText>
                                                <MudText Typo="Typo.body2" Inline="true" Color="Color.Secondary">@syncStatus.ParallelCopies</MudText>
                                            </li>
                                            @if (syncStatus.DelayAfterRecording != null)
                                            {
                                                <li>
                                                    <MudText Typo="Typo.body2" Inline="true">Footage reaches the share after recording: </MudText>
                                                    <MudText Typo="Typo.body2" Inline="true" Color="Color.Secondary">@FormatDuration(syncStatus.DelayAfterRecording.Value)</MudText>
                                                </li>
                                            }
                                        </ul>
                                    }

                                    @if (syncAlert != null)
                                    {
                                        <MudAlert Dense="true" Severity="syncAlert.Value.Severity">@syncAlert.Value.Message</MudAlert>
                                    }
                                </MudStack>
                            }
                            else if (target.Id != null && target.IsSyncEnabled)
                            {
                                <MudStack Class="mt-3" Spacing="1">
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2">Sync load</MudText>
                                        <MudText Typo="Typo.body2">Starting</MudText>
                                    </MudStack>
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Medium" />
                                </MudStack>
                            }
                        </MudPaper>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
        <MudCard Elevation="4" Style="width:800px; height:350px">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Local Server-Side Storage</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Retention settings for the localy saved/encoded footage.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="4">
                    <MudSelect T="RetentionPeriod"
                               Label="Encoded videos expire after"
                               @bind-Value="_settings.EncodedVideoRetention"
                               HelperText="Exported MP4 videos are removed from disk after this period.">
                        @foreach (var period in Enum.GetValues<RetentionPeriod>())
                        {
                            <MudSelectItem Value="@period">@MiscUtilities.GetDisplayNameAttributeValue(period)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="RetentionPeriod"
                               Label="Camera chunks removal"
                               @bind-Value="_settings.CameraChunkRetention"
                               HelperText="Recorded camera footage chunks and their metadata are deleted after this period.">
                        @foreach (var period in Enum.GetValues<RetentionPeriod>())
                        {
                            <MudSelectItem Value="@period">@MiscUtilities.GetDisplayNameAttributeValue(period)</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@(_isSaving ? null : Icons.Material.Filled.Save)"
                           OnClick="SaveServerSideStorageSettingsAsync"
                           Disabled="_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Saving</MudText>
                    }
                    else
                    {
                        <MudText>Save</MudText>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudStack>
</MudStack>

@code {
    private SystemSettingsDto _settings = new();
    private List<RemoteStorageTargetModel> _targets = new();
    private bool _isSaving = false;
    private bool _isSavingRemoteStorage = false;
    private CancellationTokenSource? _parallelCopiesSaveDelayCancellationTokenSource;
    private Dictionary<Guid, RemoteStorageSyncStatusDto> _syncStatuses = new();
    private List<CameraRecordingRateDto> _cameraRecordingRates = new();
    private Dictionary<Guid, string> _cameraNames = new();

    private const int _camerasToSuggest = 3;
    private const int _minimumParallelCopies = 1;
    private const int _maximumParallelCopies = 20;
    private const double _bytesPerMegabyte = 1024 * 1024;
    private const double _bitsPerMegabit = 1_000_000;

    private readonly TimeSpan _syncStatusRefreshInterval = TimeSpan.FromSeconds(5);
    private readonly TimeSpan _parallelCopiesSaveDelay = TimeSpan.FromSeconds(1);
    private readonly CancellationTokenSource _refreshCancellationTokenSource = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await _systemSettingsService.GetSystemSettingsAsync();
        _targets = await _remoteStorageService.GetTargetsAsync();
        _cameraNames = (await _deviceService.GetAllCameraNameAndIdAsync()).ToDictionary(x => x.Id, x => x.Name);

        if (_targets.Count == 0)
            AddTarget();

        RefreshSyncStatuses();

        _ = RefreshSyncStatusesPeriodicallyAsync(_refreshCancellationTokenSource.Token);
    }

    public void Dispose()
    {
        _refreshCancellationTokenSource.Cancel();
        _refreshCancellationTokenSource.Dispose();
    }

    private async Task RefreshSyncStatusesPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(_syncStatusRefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    RefreshSyncStatuses();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void RefreshSyncStatuses()
    {
        _syncStatuses = _targets
            .Where(x => x.Id != null)
            .Select(x => _remoteStorageSyncMonitor.GetSyncStatus(x.Id!.Value))
            .OfType<RemoteStorageSyncStatusDto>()
            .ToDictionary(x => x.TargetId);

        _cameraRecordingRates = _remoteStorageSyncMonitor.GetCameraRecordingRates();
    }

    private Color GetLoadColor(RemoteStorageSyncStatusDto syncStatus)
    {
        return syncStatus.State switch
        {
            RemoteStorageSyncState.Overloaded or RemoteStorageSyncState.Unreachable => Color.Error,
            RemoteStorageSyncState.NearCapacity => Color.Warning,
            RemoteStorageSyncState.CatchingUp => Color.Info,
            _ => Color.Success
        };
    }

    private async Task OnParallelCopiesPerShareChangedAsync(int parallelCopiesPerShare)
    {
        _settings.ParallelCopiesPerShare = Math.Clamp(parallelCopiesPerShare, _minimumParallelCopies, _maximumParallelCopies);

        _parallelCopiesSaveDelayCancellationTokenSource?.Cancel();
        _parallelCopiesSaveDelayCancellationTokenSource?.Dispose();
        _parallelCopiesSaveDelayCancellationTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(_parallelCopiesSaveDelay, _parallelCopiesSaveDelayCancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await SaveParallelCopiesPerShareAsync();
    }

    private async Task SaveParallelCopiesPerShareAsync()
    {
        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        var latestSettings = await _systemSettingsService.GetSystemSettingsAsync();

        if (latestSettings.ParallelCopiesPerShare == _settings.ParallelCopiesPerShare)
        {
            return;
        }

        latestSettings.ParallelCopiesPerShare = _settings.ParallelCopiesPerShare;

        if (!await _systemSettingsService.UpdateSystemSettingsAsync(latestSettings))
        {
            _snackbar.Add("Failed to save parallel copies.", Severity.Error);

            return;
        }

        _remoteStorageSyncController.RequestRefresh();
        _snackbar.Add($"Parallel copies per share set to {_settings.ParallelCopiesPerShare}.", Severity.Success);
    }

    private (Severity Severity, string Message)? GetSyncAlert(RemoteStorageSyncStatusDto syncStatus)
    {
        return syncStatus.State switch
        {
            RemoteStorageSyncState.NearCapacity => (Severity.Warning,
                $"The connection to this share is close to its limit. Adding cameras or raising their resolution can make the sync fall behind. {DescribeBusiestCameras()}"),
            RemoteStorageSyncState.Overloaded => (Severity.Error,
                $"The cameras record more video than this share receives ({ToMegabitsPerSecond(syncStatus.UploadMegabytesPerSecond):0.0} Mbit/s), so the sync is falling behind. "
                + $"First check the upload speed of the server's network. If it is clearly higher than {ToMegabitsPerSecond(syncStatus.UploadMegabytesPerSecond):0.0} Mbit/s, raise Parallel copies per share (now {syncStatus.ParallelCopies}), keeping enough upload free for remote viewing. "
                + $"If it is about the same, the network is full, so lower the resolution or quality of the cameras that record the most. {DescribeBusiestCameras()}"),
            RemoteStorageSyncState.CatchingUp => (Severity.Info,
                syncStatus.CatchUpTimeRemaining == null
                    ? $"Catching up on {syncStatus.PendingChunkCount} chunks."
                    : $"Catching up on {syncStatus.PendingChunkCount} chunks, about {FormatDuration(syncStatus.CatchUpTimeRemaining.Value)} left."),
            RemoteStorageSyncState.Unreachable => (Severity.Error,
                $"The share cannot be reached. {syncStatus.PendingChunkCount} chunks are waiting and will be copied when it is back."),
            _ => null
        };
    }

    private string DescribeBusiestCameras()
    {
        var busiestCameras = _cameraRecordingRates
            .Take(_camerasToSuggest)
            .Select(x => $"{_cameraNames.GetValueOrDefault(x.DeviceId, "Unknown camera")} {x.MegabytesPerSecond:0.00} MB/s")
            .ToList();

        return busiestCameras.Count == 0
            ? string.Empty
            : $"Cameras recording the most: {string.Join(", ", busiestCameras)}.";
    }

    private string FormatRate(double megabytesPerSecond)
    {
        return $"{megabytesPerSecond:0.00} MB/s ({ToMegabitsPerSecond(megabytesPerSecond):0.0} Mbit/s)";
    }

    private double ToMegabitsPerSecond(double megabytesPerSecond)
    {
        return megabytesPerSecond * _bytesPerMegabyte * 8 / _bitsPerMegabit;
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalSeconds < 1)
        {
            return $"{Math.Max(duration.TotalMilliseconds, 0):0} ms";
        }

        if (duration.TotalMinutes < 1)
        {
            return $"{duration.TotalSeconds:0.0} s";
        }

        return duration.TotalHours < 1
            ? $"{duration.TotalMinutes:0} min"
            : $"{duration.TotalHours:0.0} h";
    }

    private void AddTarget()
    {
        _targets.Add(new RemoteStorageTargetModel());
    }

    private async Task RemoveTargetAsync(RemoteStorageTargetModel target)
    {
        if (target.Id == null)
        {
            _targets.Remove(target);

            return;
        }

        var isConfirmed = await _dialogService.ShowMessageBox(
            "Remove Share",
            (MarkupString)$"Are you sure you want to remove <b>{WebUtility.HtmlEncode(target.SharePath)}</b>?<br /><br /><span style=\"color: var(--mud-palette-error);\">Video sync to this share stops. Footage already copied stays on the share, but it is no longer deleted by retention or played back from there.</span>",
            yesText: "Remove",
            cancelText: "Cancel");

        if (isConfirmed != true || !await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        target.IsVerifying = true;

        try
        {
            var result = await _remoteStorageService.DeleteTargetAsync(target.Id.Value);

            if (!result.Succeeded)
            {
                _snackbar.Add(result.Message, Severity.Error);

                return;
            }

            _snackbar.Add(result.Message, Severity.Success);
            _targets = await _remoteStorageService.GetTargetsAsync();

            RefreshSyncStatuses();
        }
        finally
        {
            target.IsVerifying = false;
        }
    }

    private async Task SaveAndVerifyTargetAsync(RemoteStorageTargetModel target)
    {
        try
        {
            if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
            {
                return;
            }

            _isSavingRemoteStorage = true;

            await InvokeAsync(StateHasChanged);

            if (!await RunVerificationAsync(target))
            {
                return;
            }

            target.IsSyncEnabled = true;

            await SaveRemoteStorageAsync(target);
        }
        finally
        {
            _isSavingRemoteStorage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSyncChangedAsync(RemoteStorageTargetModel target, bool isEnabled)
    {
        if (!isEnabled)
        {
            target.IsSyncEnabled = false;

            await SaveRemoteStorageAsync(target);

            return;
        }

        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        target.IsSyncEnabled = await RunVerificationAsync(target);

        if (target.IsSyncEnabled)
        {
            await SaveRemoteStorageAsync(target);
        }
    }

    private async Task<bool> RunVerificationAsync(RemoteStorageTargetModel target)
    {
        target.VerificationMessage = null;

        var result = await _remoteStorageService.VerifyTargetAsync(target);

        target.VerificationSucceeded = result.Succeeded;
        target.VerificationMessage = result.Message;

        if (result.Succeeded)
        {
            _snackbar.Add("Connection verified.", Severity.Info);
        }
        else
        {
            _snackbar.Add("Connection verification failed.", Severity.Error);
        }
        

        return result.Succeeded;
    }

    private async Task SaveRemoteStorageAsync(RemoteStorageTargetModel target)
    {
        var result = await _remoteStorageService.SaveTargetAsync(target);

        if (!result.Succeeded)
        {
            _snackbar.Add(result.Message, Severity.Error);
            return;
        }

        _snackbar.Add(result.Message, Severity.Success);
        _targets = await _remoteStorageService.GetTargetsAsync();
    }

    private async Task SaveServerSideStorageSettingsAsync()
    {
        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        _isSaving = true;

        try
        {
            var success = await _systemSettingsService.UpdateSystemSettingsAsync(_settings);

            if (success)
            {
                _snackbar.Add("Retention settings saved.", Severity.Success);
            }
            else
            {
                _snackbar.Add("Failed to save retention settings.", Severity.Error);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
