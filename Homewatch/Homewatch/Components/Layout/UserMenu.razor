@inject NavigationManager _navigationManager

<AuthorizeView>
    <Authorized>
        <MudMenu @ref="_menu"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 PopoverClass="header-menu-popover"
                 ListClass="header-menu-popover-list">
            <ActivatorContent>
                <span class="user-menu-activator">
                    <MudAvatar Color="Color.Primary"
                               Size="Size.Medium"
                               Class="user-menu-avatar">
                        @GetInitial(context.User.Identity?.Name)
                    </MudAvatar>
                </span>
            </ActivatorContent>
            <ChildContent>
                <div class="header-menu header-menu-compact">
                    <div class="header-menu-header">
                        <span class="header-menu-title">@context.User.Identity?.Name</span>
                    </div>
                    <div class="header-menu-list">
                        <button type="button" class="header-menu-row" @onclick="OpenUserSettingsAsync">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" />
                            <span>User Settings</span>
                        </button>
                    </div>
                    <form class="header-menu-footer-form" method="post" action="/api/auth/logout" onsubmit="window.showSubmitOverlay()">
                        <AntiforgeryToken />
                        <button type="submit" class="header-menu-footer header-menu-footer-danger">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </ChildContent>
        </MudMenu>
    </Authorized>
</AuthorizeView>

@code {
    private MudMenu? _menu;

    private async Task OpenUserSettingsAsync()
    {
        if (_menu != null)
        {
            await _menu.CloseMenuAsync();
        }

        _navigationManager.NavigateTo(AppRoutes.UserSettings);
    }

    private static string GetInitial(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim()[..1].ToUpperInvariant();
    }
}
